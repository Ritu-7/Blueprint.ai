{
  "metadata": {
    "appName": "NexusCore",
    "theme": "dark",
    "defaultLanguage": "en",
    "supportedLanguages": ["en", "es", "fr", "ja"]
  },
  "auth": {
    "enabled": true,
    "methods": ["email"],
    "protectedRoutes": ["/dashboard"]
  },
  "schema": {
    "projects": {
      "fields": {
        "id": { "type": "string", "primary": true },
        "name": { "type": "string", "required": true },
        "description": { "type": "string" },
        "status": { "type": "string", "default": "active" },
        "budget": { "type": "number", "default": 0 },
        "is_priority": { "type": "boolean", "default": false },
        "deadline": { "type": "date" },
        "created_at": { "type": "date", "default": "now()" }
      }
    },
    "tasks": {
      "fields": {
        "id": { "type": "string", "primary": true },
        "project_id": { "type": "string", "required": true, "references": "projects.id" },
        "title": { "type": "string", "required": true },
        "description": { "type": "string" },
        "status": { "type": "string", "default": "pending" },
        "priority": { "type": "number", "default": 0 },
        "completed": { "type": "boolean", "default": false },
        "due_date": { "type": "date" },
        "created_at": { "type": "date", "default": "now()" }
      }
    },
    "team_members": {
      "fields": {
        "id": { "type": "string", "primary": true },
        "name": { "type": "string", "required": true },
        "email": { "type": "string", "required": true },
        "role": { "type": "string", "default": "member" },
        "is_active": { "type": "boolean", "default": true },
        "joined_at": { "type": "date", "default": "now()" }
      }
    }
  },
  "layout": {
    "pages": [
      {
        "id": "dashboard",
        "path": "/dashboard",
        "title": "Dashboard",
        "icon": "LayoutDashboard",
        "sections": [
          {
            "id": "stats",
            "type": "Section",
            "props": {
              "title": "Overview",
              "columns": 4
            },
            "children": [
              {
                "id": "stat-projects",
                "type": "StatCard",
                "props": {
                  "label": "Total Projects",
                  "resource": "projects",
                  "icon": "FolderKanban",
                  "color": "cyan"
                }
              },
              {
                "id": "stat-tasks",
                "type": "StatCard",
                "props": {
                  "label": "Total Tasks",
                  "resource": "tasks",
                  "icon": "CheckSquare",
                  "color": "green"
                }
              },
              {
                "id": "stat-members",
                "type": "StatCard",
                "props": {
                  "label": "Team Members",
                  "resource": "team_members",
                  "icon": "Users",
                  "color": "amber"
                }
              },
              {
                "id": "stat-priority",
                "type": "StatCard",
                "props": {
                  "label": "Priority Tasks",
                  "resource": "tasks",
                  "icon": "AlertTriangle",
                  "color": "rose",
                  "filter": { "is_priority": true }
                }
              }
            ]
          },
          {
            "id": "projects-section",
            "type": "Section",
            "props": {
              "title": "Projects",
              "columns": 1
            },
            "children": [
              {
                "id": "projects-table",
                "type": "DataTable",
                "props": {
                  "resource": "projects",
                  "columns": ["name", "status", "budget", "deadline"],
                  "searchable": true,
                  "creatable": true,
                  "editable": true,
                  "deletable": true
                }
              }
            ]
          },
          {
            "id": "tasks-section",
            "type": "Section",
            "props": {
              "title": "Tasks",
              "columns": 1
            },
            "children": [
              {
                "id": "tasks-table",
                "type": "DataTable",
                "props": {
                  "resource": "tasks",
                  "columns": ["title", "status", "priority", "completed", "due_date"],
                  "searchable": true,
                  "creatable": true,
                  "editable": true,
                  "deletable": true
                }
              }
            ]
          },
          {
            "id": "team-section",
            "type": "Section",
            "props": {
              "title": "Team Members",
              "columns": 1
            },
            "children": [
              {
                "id": "team-table",
                "type": "DataTable",
                "props": {
                  "resource": "team_members",
                  "columns": ["name", "email", "role", "is_active"],
                  "searchable": true,
                  "creatable": true,
                  "editable": true,
                  "deletable": true
                }
              }
            ]
          }
        ]
      }
    ]
  },
